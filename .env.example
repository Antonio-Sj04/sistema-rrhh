# Variables del BACKEND (API REST en /api/v1). El navegador no recibe ninguna.
# Copia este archivo como .env para desarrollo local; en producción se
# configuran en Netlify → Project configuration → Environment variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxx

# SECRETA. Solo la usa la API para invitar/eliminar usuarios y recibir
# postulaciones del portal. Nunca la pongas en código del cliente.
SUPABASE_SERVICE_ROLE_KEY=

# SECRETA. Conexión SQL directa (Supabase → Connect → Transaction pooler).
# Ej.: postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=
